# ============================================================
# AI 智能在线考试平台 - 环境变量配置
# 使用方式：cp .env.example .env，然后按实际环境修改
# 所有敏感信息只通过本文件注入，禁止写入代码或镜像
# ============================================================

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- MySQL 数据库 ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=ems
MYSQL_USER=xzs
MYSQL_PASSWORD=change-me-app-password
# 宿主机暴露的数据库端口（生产环境可改为只对内网开放）
MYSQL_PORT=3306

# ---------- 数据库连接（可选：默认按上面的 MySQL 参数自动拼接）----------
# DATABASE_URL=jdbc:mysql://db:3306/ems?useSSL=false&useUnicode=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&allowPublicKeyRetrieval=true&allowMultiQueries=true

# ---------- 后端 / 前端端口 ----------
BACKEND_PORT=8000
FRONTEND_PORT=80

# ---------- DeepSeek AI 出题（可选）----------
# 不配置 Key 时，真实 AI 出题不可用，但可在「AI 智能出题」页点击「加载 Demo 示例」完成演示
DEEPSEEK_API_KEY=
# 官方 DeepSeek 接口：
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-chat
# 如使用其他 OpenAI 兼容服务，修改 AI_API_URL / AI_MODEL 即可
